{
  "name": "backend",
  "version": "1.0.0",
  "description": "Cloudflare Workers + Hono Backend cho PWA Quay Video Kho Vận",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "d1:init": "wrangler d1 execute quayvideo-db --local --file=./migrations/0001_initial_schema.sql",
    "d1:seed": "wrangler d1 execute quayvideo-db --local --file=./migrations/0002_seed_data.sql",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "test:all": "vitest run --dir tests --exclude=\"\""
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "bcryptjs": "^3.0.3",
    "hono": "^4.7.4",
    "jose": "^6.0.8",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260914.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.3",
    "typescript": "^5.8.2",
    "vitest": "^5.0.0",
    "wrangler": "^4.131.2"
  }
}
